/* page 作用于整页；.page 是 WXML 中 class="page" 的容器。
   rpx 是按屏幕宽度换算的单位；safe-area-inset-bottom 为手机底部安全区域留空。 */
page { background: #f6f8f7; color: #202c29; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 32rpx 40rpx; padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); box-sizing: border-box; max-width: 900rpx; margin: 0 auto; }
.header { display: flex; align-items: baseline; flex-wrap: wrap; gap: 16rpx; padding: 8rpx 0 36rpx; }
.brand { font-size: 44rpx; font-weight: 600; }
.brand-en { font-size: 24rpx; color: #6b7873; }
/* Flex 布局让两种语言左右排列；flex: 1 平分剩余空间，min-width: 0 允许内容收缩。 */
.language-row { display: flex; align-items: center; border-top: 1rpx solid #dce3df; border-bottom: 1rpx solid #dce3df; padding: 28rpx 0; }
.language { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.target { text-align: right; }
.language-name { font-size: 34rpx; font-weight: 600; }
.language-detail { color: #74817b; font-size: 23rpx; }
.direction { font-size: 38rpx; color: #16846e; padding: 0 24rpx; }
.result-section { padding: 34rpx 0 0; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; font-size: 26rpx; font-weight: 500; }
.service-status { color: #866923; font-size: 22rpx; font-weight: 400; }
.empty-result { min-height: 280rpx; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 24rpx 0; box-sizing: border-box; }
/* 五条短线是静态占位图案，不代表实时麦克风音量。 */
.sound-mark { height: 48rpx; display: flex; gap: 8rpx; align-items: center; margin-bottom: 22rpx; }
.sound-mark view { width: 6rpx; height: 18rpx; background: #94b9ac; border-radius: 3rpx; }
.sound-mark view:nth-child(2), .sound-mark view:nth-child(4) { height: 32rpx; }
.sound-mark view:nth-child(3) { height: 48rpx; }
.empty-title { font-size: 28rpx; color: #596b62; }
.empty-description { font-size: 23rpx; color: #7d8882; margin-top: 12rpx; line-height: 1.7; }
.record-section { border-top: 1rpx solid #dce3df; padding-top: 30rpx; text-align: center; }
.record-status { display: flex; justify-content: center; align-items: center; gap: 12rpx; font-size: 24rpx; color: #596b62; min-height: 40rpx; }
.status-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #9ca9a2; flex-shrink: 0; }
.status-dot.active { background: #c84d53; }
.timer { display: block; font-size: 58rpx; font-weight: 500; font-variant-numeric: tabular-nums; margin-top: 10rpx; line-height: 1.3; }
.duration-limit { display: block; font-size: 22rpx; color: #7d8882; margin: 8rpx 0 28rpx; }
button { border-radius: 12rpx; font-size: 28rpx; font-weight: 500; box-sizing: border-box; }
/* 微信原生 button 的默认边框绘制在 ::after 上，在这里去掉。 */
button::after { border: none; }
.record-button { background: #127b64; color: #fff; width: 100%; height: 96rpx; line-height: 96rpx; }
.record-button.stop-button { background: #b7434b; }
/* 属性选择器匹配被禁用的按钮，颜色与可点击状态区分开。 */
.record-button[disabled] { background: #dce4df; color: #718078; }
.audio-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.secondary-button { flex: 1; min-width: 0; margin: 0; padding: 0 12rpx; height: 80rpx; line-height: 80rpx; background: #e7efeb; color: #176d59; font-size: 26rpx; }
.clear-button { background: #ebedee; color: #59636b; }
.secondary-button[disabled] { background: #edf0ee; color: #a1aaa5; }
.privacy-note { display: block; margin-top: 24rpx; font-size: 22rpx; color: #7d8882; line-height: 1.6; }
.upload-button { width: 100%; margin-top: 20rpx; background: #e1e9f4; color: #345782; }
